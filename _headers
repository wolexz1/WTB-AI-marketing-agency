# Pages that should stay out of search results.
/thank-you.html
  X-Robots-Tag: noindex, follow

/thank-you/index.html
  X-Robots-Tag: noindex, follow

/ai-explorers/thank-you/*
  X-Robots-Tag: noindex, follow

/whatsapp-ai-guides/thank-you/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: private, no-store, max-age=0
  Referrer-Policy: strict-origin-when-cross-origin

/whatsapp-ai-guides/digital-product-policy/*
  X-Robots-Tag: noindex, follow

/api/whatsapp-ai-guides/*
  Cache-Control: private, no-store, max-age=0
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/whatsapp-ai-guides/*
  Cache-Control: public, max-age=604800, immutable

/llms.txt
  X-Robots-Tag: noindex, follow
  Link: <https://wtbaimarketing.com/>; rel="canonical"
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate

/markdown-mirror.md
  X-Robots-Tag: noindex, follow
  Link: <https://wtbaimarketing.com/>; rel="canonical"
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate

/AI_OVERVIEW_GEO_AEO_AUDIT_2026-06-09.md
  X-Robots-Tag: noindex, nofollow

/BLOG_INTENT_SCORECARD.md
  X-Robots-Tag: noindex, nofollow

/BLOG_PUBLICATION_STANDARD.md
  X-Robots-Tag: noindex, nofollow

/CONTENT_ACTION_BOARD.md
  X-Robots-Tag: noindex, nofollow

/DISTRIBB_HUB_SETUP.md
  X-Robots-Tag: noindex, nofollow

/FORM_BACKEND_SETUP.md
  X-Robots-Tag: noindex, nofollow

/agents.json
  X-Robots-Tag: noindex, nofollow

/wrangler.jsonc
  X-Robots-Tag: noindex, nofollow

/docs/*
  X-Robots-Tag: noindex, nofollow

/WTB-AI-marketing-agency-upload-20260505-200008/*
  X-Robots-Tag: noindex, nofollow

/WTB-AI-marketing-agency/WTB-AI-marketing-agency-upload-20260505-200008/*
  X-Robots-Tag: noindex, nofollow

# Static files can be reused on repeat visits. Root CSS and JS use a short
# revalidation window because their filenames do not change on every release.
/styles.css
  Cache-Control: public, max-age=3600, must-revalidate

/script.js
  Cache-Control: public, max-age=60, must-revalidate

/assets/*
  Cache-Control: public, max-age=86400
