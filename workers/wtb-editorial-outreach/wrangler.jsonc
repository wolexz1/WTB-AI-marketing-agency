{
  "$schema": "../../.wrangler/config-schema.json",
  "name": "wtb-editorial-outreach",
  "main": "src/index.js",
  "compatibility_date": "2026-09-17",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 9 * * 3"]
  },
  "vars": {
    "ADMIN_EMAIL": "wolexzthebrand@gmail.com",
    "FROM_EMAIL": "WTB AI Marketing Agency <hello@wtbaimarketing.com>",
    "MAX_INITIAL_OUTREACH_PER_RUN": "5",
    "FOLLOW_UP_AFTER_DAYS": "6"
  },
  "d1_databases": [
    {
      "binding": "OUTREACH_DB",
      "database_name": "wtb-editorial-outreach",
      "database_id": "REPLACE_AFTER_D1_CREATE",
      "migrations_dir": "migrations"
    }
  ]
}
